            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(up{k8s_cluster=~\"$k8s_cluster\"} == 0) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Nodes not Ready",
      "datasource": {
